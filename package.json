{
  "name": "mimo-workbench",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "dist/server.mjs",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "node server/index.mjs",
    "build": "vite build && node scripts/build-server.mjs",
    "start": "node dist/server.mjs",
    "test": "node --test tests/*.test.mjs",
    "check": "node --check server/app.mjs && node --check server/sources.mjs && node --check server/agent.mjs",
    "verify:artifact": "node scripts/verify-artifact.mjs"
  },
  "dependencies": {
    "vue": "3.5.43",
    "express": "5.2.1",
    "mysql2": "3.24.5",
    "imapflow": "2.2.7",
    "mailparser": "3.9.36",
    "zod": "4.6.5",
    "vite": "8.3.3",
    "@vitejs/plugin-vue": "6.0.9",
    "esbuild": "0.28.2"
  }
}
